					"name": "Listar recetas",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"",
									"const recipes = pm.response.json();",
									"",
									"const recipesToSave = {",
									"    \"Albóndigas en salsa\": \"recipeIdAlbondigas\",",
									"    \"Ensalada de pasta\": \"recipeIdEnsalada\",",
									"    \"Espaguetis a la carbonara\": \"recipeIdCarbonara\",",
									"    \"Merluza en salsa verde\": \"recipeIdMerluza\",    ",
									"    \"Tortilla de patatas\": \"recipeIdTortilla\",",
									"    \"Tarta de manzana\": \"recipeIdTarta\"",
									"};",
									"",
									"recipes.forEach(recipe => {",
									"    const variableName = recipesToSave[recipe.name];",
									"",
									"    if (variableName) {",
									"        pm.collectionVariables.set(variableName, recipe._id);",
									"        console.log(`${recipe.name}: ${recipe._id}`);",
									"    }",
									"});",
									"",
									"// Comprobar si se han encontrado todas las recetas",
									"Object.entries(recipesToSave).forEach(([name, variable]) => {",
									"    if (!recipes.some(recipe => recipe.name === name)) {",
									"        console.warn(`No se ha encontrado: ${name}`);",
									"    }",
									"});",
									""
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
