						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Lasaña de carne\",\n  \"description\": \"Lasaña casera con carne picada, tomate y bechamel.\",\n  \"origin\": \"Curso de cocina\",\n  \"url\": \"\",\n  \"category\": \"carnes\",\n  \"difficulty\": \"medium\",\n  \"preparationTime\": 30,\n  \"cookingTime\": 45,\n  \"servings\": 4,\n  \"notes\": \"Dejar reposar unos minutos antes de servir.\",\n  \"visibility\": \"private\",\n  \"authorizedUsers\": [],\n  \"ingredients\": [\n    {\n      \"name\": \"Carne picada\",\n      \"quantity\": 500,\n      \"unit\": \"g\",\n      \"section\": \"meat\",\n      \"observations\": \"\",\n      \"optional\": false\n    },\n    {\n      \"name\": \"Tomate triturado\",\n      \"quantity\": 400,\n      \"unit\": \"g\",\n      \"section\": \"fruit_vegetables\",\n      \"observations\": \"\",\n      \"optional\": false\n    },\n    {\n      \"name\": \"Placas de lasaña\",\n      \"quantity\": 12,\n      \"unit\": \"unit\",\n      \"section\": \"pasta_rice_legumes\",\n      \"observations\": \"\",\n      \"optional\": false\n    },\n    {\n      \"name\": \"Leche\",\n      \"quantity\": 500,\n      \"unit\": \"ml\",\n      \"section\": \"dairy_eggs\",\n      \"observations\": \"\",\n      \"optional\": false\n    },\n    {\n      \"name\": \"Queso rallado\",\n      \"quantity\": 100,\n      \"unit\": \"g\",\n      \"section\": \"dairy_eggs\",\n      \"observations\": \"Para gratinar\",\n      \"optional\": true\n    }\n  ],\n  \"steps\": [\n    {\n      \"order\": 1,\n      \"description\": \"Preparar la carne picada en una sartén con un poco de aceite.\"\n    },\n    {\n      \"order\": 2,\n      \"description\": \"Añadir el tomate triturado y cocinar durante 15 minutos.\"\n    },\n    {\n      \"order\": 3,\n      \"description\": \"Preparar la bechamel calentando la leche y mezclándola con harina y mantequilla.\"\n    },\n    {\n      \"order\": 4,\n      \"description\": \"Montar la lasaña alternando placas, carne y bechamel.\"\n    },\n    {\n      \"order\": 5,\n      \"description\": \"Cubrir con queso rallado y hornear hasta que esté gratinada.\"\n    }\n  ]\n}\n\n",
